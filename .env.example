# Local-only by default. Do not expose this server to the internet.
PORT=8787
GITHUB_TOKEN=
# Have I Been Pwned licensed account-breach lookup. Use only for accounts you own or are authorized to audit.
HIBP_API_KEY=
# Blockscout PRO API key for supported EVM chains. Bitcoin uses the public mempool API.
BLOCKSCOUT_API_KEY=
# Comma-separated authorized literal IPs, domains, .onion hosts, or private IPv4 CIDRs.
# Loopback is included by default for testing your own local services.
SCAN_ALLOWLIST=127.0.0.1,::1,localhost
TOR_HOST=127.0.0.1
TOR_PORT=9050
# Optional street-map provider. Public OpenStreetMap tiles work without a key.
# Keep {z}/{x}/{y} placeholders and set your provider's required attribution.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION_TEXT=© OpenStreetMap contributors
VITE_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
