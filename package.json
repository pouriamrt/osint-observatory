{
  "name": "osint-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:cameras:ui": "node scripts/camera-browsing-ui.mjs",
    "test:streets:ui": "node scripts/street-map-ui.mjs",
    "test:map-markers:ui": "node scripts/map-marker-ui.mjs",
    "test:satellite:ui": "node scripts/satellite-ui.mjs",
    "test:satellite:detail": "node scripts/satellite-detail-ui.mjs",
    "test:live-views:ui": "node scripts/live-views-ui.mjs",
    "test:radio:ui": "node scripts/radio-ui.mjs",
    "test:radio:analysis:ui": "node scripts/radio-analysis-ui.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socks": "^2.8.7",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "@playwright/test": "^1.56.1"
  }
}
